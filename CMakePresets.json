{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (Visual Studio)",
      "binaryDir": "${sourceDir}/out/build/x64",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/out/bin/x64",
        "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/out/bin/x64"
      }
    },
    {
      "name": "windows-arm64",
      "displayName": "Windows ARM64 (Visual Studio)",
      "binaryDir": "${sourceDir}/out/build/arm64",
      "architecture": {
        "value": "ARM64",
        "strategy": "set"
      },
      "cacheVariables": {
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/out/bin/arm64",
        "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/out/bin/arm64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "arm64-release",
      "configurePreset": "windows-arm64",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
